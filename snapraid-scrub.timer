[Unit]
Description=SnapRAID Scrub Timer (Weekly on Sunday)
Documentation=man:snapraid(1)

[Timer]
# Run weekly on Sunday at 3 AM
OnCalendar=Sun *-*-* 03:00:00

# If system was off, run on next boot
Persistent=true

# Random delay to avoid conflicts
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
